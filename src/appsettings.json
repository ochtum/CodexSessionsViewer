{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Viewer": {
    "DefaultUrl": "http://127.0.0.1:8765",
    "LaunchBrowserOnStartup": true,
    "AutoSelectAvailablePortOnConflict": true,
    "PortFallbackRange": 20
  },
  "Pricing": {
    "CatalogPath": "model-pricing.json",
    "CatalogUrl": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json",
    "CatalogCachePath": ".cache/model-pricing-cache.json",
    "CatalogRefreshIntervalMinutes": 720,
    "CatalogRequestTimeoutSeconds": 10
  },
  "OpenAI": {
    "ModelsEndpoint": "https://api.openai.com/v1/models",
    "ModelsRefreshIntervalMinutes": 720
  },
  "ExchangeRates": {
    "Endpoint": "https://cdn.moneyconvert.net/api/latest.json",
    "RefreshIntervalMinutes": 10
  },
  "AllowedHosts": "*"
}
