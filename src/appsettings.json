{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Viewer": {
    "DefaultUrl": "http://127.0.0.1:8765",
    "LaunchBrowserOnStartup": true,
    "AutoSelectAvailablePortOnConflict": true,
    "PortFallbackRange": 20
  },
  "Pricing": {
    "CatalogPath": "model-pricing.json"
  },
  "OpenAI": {
    "ModelsEndpoint": "https://api.openai.com/v1/models",
    "ModelsRefreshIntervalMinutes": 720
  },
  "AllowedHosts": "*"
}
